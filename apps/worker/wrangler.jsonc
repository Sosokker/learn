{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "learn",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "learn.sirin.dev", "custom_domain": true }],
  // The SPA is built by apps/web. The Worker runs first only for the API and content bodies;
  // every other path is a static asset or falls back to index.html.
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/c/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn",
      // From `wrangler d1 create learn` (see README, one-time setup).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "learn-content" }],
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Hot score every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "PUBLIC_URL": "https://learn.sirin.dev" }
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
