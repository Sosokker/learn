# Copy to .dev.vars for `bun run dev`. Never commit .dev.vars.
PUBLIC_URL=http://localhost:5173
# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
